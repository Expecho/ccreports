  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "github-copilot",
    "copilot",
    "cursor",
    "usage",
    "tokens",
    "cost",
    "report",
    "cli"
  ],
  "author": "Peter Bons",
  "license": "MIT",
  "homepage": "https://github.com/Expecho/ccreports#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Expecho/ccreports.git"
  },
  "bugs": {
    "url": "https://github.com/Expecho/ccreports/issues"
  },
  "type": "module",
  "bin": {
    "ccreports": "bin/ccreports.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "start": "node bin/ccreports.mjs",
    "test": "node --test",
    "prepublishOnly": "npm test",
    "version": "node scripts/sync-version.mjs && git add .claude-plugin/plugin.json"
